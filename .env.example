# ==============================================================================
# PrepMate - AI Interview Trainer Agent (.env configuration)
# AICTE-IBM SkillsBuild University Engagements 2026 (Problem Statement #22)
# ==============================================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=prepmate_secret_key_change_in_production_2026
PORT=5000

# IBM watsonx.ai Configuration (IBM Cloud Lite / Paid)
# Obtain your API Key from: https://cloud.ibm.com/iam/apikeys
WATSONX_APIKEY=your_ibm_cloud_api_key_here

# Obtain your Project ID from watsonx.ai: Project -> Manage -> General -> Details -> Project ID
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM watsonx.ai Service URL (Default: Dallas us-south, Frankfurt eu-de, Tokyo jp-tok, etc.)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model ID
# Recommended models:
# - ibm/granite-3-8b-instruct (Fast, high-quality instruction following, 3rd Gen Granite)
# - ibm/granite-13b-chat-v2
# - ibm/granite-20b-code-instruct
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# watsonx.ai REST API Version parameter
WATSONX_API_VERSION=2023-05-29

# Development Mock Mode
# Set to 'true' only if IBM Cloud credentials are not yet configured.
# Set to 'false' to strictly enforce live IBM Granite calls.
MOCK_MODE=false

# SQLite Database Location (defaults to database/prepmate.db)
DATABASE_PATH=database/prepmate.db
